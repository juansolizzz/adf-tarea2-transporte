{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Nombre de instancia de Data Factory",
			"defaultValue": "adf-ucb-transporte-us-12713688"
		},
		"ls_dl_transporte_accountKey": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"accountKey\"de \"ls_dl_transporte\""
		},
		"ls_dw_transporte_password": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"password\"de \"ls_dw_transporte\""
		},
		"ls_sql_transporte_password": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"password\"de \"ls_sql_transporte\""
		},
		"ls_dl_transporte_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://saucbtransporte92841736.dfs.core.windows.net/"
		},
		"ls_dw_transporte_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-ucb-server-transporte-92841736.database.windows.net"
		},
		"ls_dw_transporte_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "dw_transporte"
		},
		"ls_dw_transporte_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "juansoliz"
		},
		"ls_sql_transporte_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-ucb-server-transporte-92841736.database.windows.net"
		},
		"ls_sql_transporte_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "erp_transporte_db"
		},
		"ls_sql_transporte_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "juansoliz"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/ls_dl_transporte')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('ls_dl_transporte_properties_typeProperties_url')]",
					"accountKey": {
						"type": "SecureString",
						"value": "[parameters('ls_dl_transporte_accountKey')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls_dw_transporte')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('ls_dw_transporte_properties_typeProperties_server')]",
					"database": "[parameters('ls_dw_transporte_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('ls_dw_transporte_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('ls_dw_transporte_password')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls_sql_transporte')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('ls_sql_transporte_properties_typeProperties_server')]",
					"database": "[parameters('ls_sql_transporte_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('ls_sql_transporte_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('ls_sql_transporte_password')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/Bronze_paradas_sql')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ls_sql_transporte",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "AzureSqlTable",
				"schema": [
					{
						"name": "AnioFuente",
						"type": "smallint",
						"precision": 5
					},
					{
						"name": "ParadaHistoricaId",
						"type": "nvarchar"
					},
					{
						"name": "CodigoPublicado",
						"type": "nvarchar"
					},
					{
						"name": "NombreParada",
						"type": "nvarchar"
					},
					{
						"name": "Zona",
						"type": "nvarchar"
					},
					{
						"name": "Latitud",
						"type": "decimal",
						"precision": 9,
						"scale": 6
					},
					{
						"name": "Longitud",
						"type": "decimal",
						"precision": 9,
						"scale": 6
					},
					{
						"name": "VigenciaDesde",
						"type": "date"
					},
					{
						"name": "VigenciaHasta",
						"type": "date"
					},
					{
						"name": "Estado",
						"type": "nvarchar"
					}
				],
				"typeProperties": {
					"schema": "dbo",
					"table": "ParadasAzure"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_sql_transporte')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ds_bronze_demanda_paradas_csv')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ls_dl_transporte",
					"type": "LinkedServiceReference"
				},
				"folder": {
					"name": "bronze/csv"
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": "demanda_paradas.csv",
						"folderPath": "datos_csv",
						"fileSystem": "raw"
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": [
					{
						"name": "nro_parada",
						"type": "String"
					},
					{
						"name": "nombre_parada",
						"type": "String"
					},
