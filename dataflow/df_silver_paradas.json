{
	"name": "df_silver_paradas",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_paradas",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          ParadaHistoricaId as string,",
				"          CodigoPublicado as string,",
				"          NombreParada as string,",
				"          Zona as string,",
				"          Latitud as string,",
				"          Longitud as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 select(mapColumn(",
				"          ParadaHistoricaId,",
				"          NombreParada,",
				"          Zona,",
				"          Latitud,",
				"          Longitud,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 derive(ParadaHistoricaId = upper(trim(coalesce(ParadaHistoricaId, ''))),",
				"          NombreParada = trim(coalesce(NombreParada, '')),",
				"          Zona = upper(trim(coalesce(Zona, '')))) ~> derivedColumn1",
				"derivedColumn1 derive(Latitud = iif(\r",
				"    trim(coalesce(Latitud, '')) == '',\r",
				"    toDecimal(null()),\r",
				"    toDecimal(trim(Latitud))\r",
				"),",
				"          Longitud = iif(\r",
				"    trim(coalesce(Longitud, '')) == '',\r",
				"    toDecimal(null()),\r",
				"    toDecimal(trim(Longitud))\r",
				"),",
				"          Estado = upper(trim(coalesce(Estado, ''))),",
				"          VigenciaDesde = iif(\r",
				"    length(trim(VigenciaDesde)) < 6, \r",
				"    addDays(toDate('1899-12-30', 'yyyy-MM-dd'), toInteger(trim(VigenciaDesde))), \r",
				"    toDate(trim(VigenciaDesde), 'yyyy-MM-dd')\r",
				"),",
				"          VigenciaHasta = iif(\r",
				"    trim(coalesce(VigenciaHasta, '')) == '',\r",
				"    toDate(null()),\r",
				"    iif(\r",
				"        regexMatch(trim(VigenciaHasta), '^[0-9]+$'),\r",
				"        addDays(toDate('1899-12-30', 'yyyy-MM-dd'), toInteger(trim(VigenciaHasta))),\r",
				"        toDate(substring(trim(VigenciaHasta), 1, 10), 'yyyy-MM-dd')\r",
				"    )\r",
				")) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as integer,",
				"          ParadaHistoricaId as string,",
				"          CodigoPublicado as string,",
				"          NombreParada as string,",
				"          Zona as string,",
				"          Latitud as decimal(9,6),",
				"          Longitud as decimal(9,6),",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          ParadaHistoricaId,",
				"          NombreParada,",
				"          Zona,",
				"          Latitud,",
				"          Longitud,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     )) ~> sink1"
			]
		}
	}
}