{
	"name": "df_silver_demandaParadas",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_demandaParadas",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_demandaParadas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          DemandaId as string,",
				"          FechaServicio as string,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as string,",
				"          Descensos as string,",
				"          DemandaNoAtendida as string,",
				"          Metodo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 select(mapColumn(",
				"          FechaServicio,",
				"          RutaHistoricaId,",
				"          ParadaHistoricaId,",
				"          Franja,",
				"          Descensos,",
				"          DemandaNoAtendida,",
				"          Metodo",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 derive(RutaHistoricaId = upper(trim(RutaHistoricaId)),",
				"          ParadaHistoricaId = upper(trim(ParadaHistoricaId)),",
				"          Franja = trim(Franja),",
				"          Metodo = upper(trim(Metodo))) ~> derivedColumn1",
				"derivedColumn1 derive(Descensos = iif(isNull(Descensos) || trim(Descensos) == '', 0, toInteger(trim(Descensos))),",
				"          DemandaNoAtendida = iif(isNull(DemandaNoAtendida) || trim(DemandaNoAtendida) == '', 0, toInteger(trim(DemandaNoAtendida))),",
				"          FechaServicio = iif(\r",
				"    length(trim(FechaServicio)) < 6, \r",
				"    addDays(toDate('1899-12-30', 'yyyy-MM-dd'), toInteger(trim(FechaServicio))), \r",
				"    toDate(trim(FechaServicio), 'yyyy-MM-dd')\r",
				")) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as integer,",
				"          DemandaId as string,",
				"          FechaServicio as date,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as integer,",
				"          Descensos as integer,",
				"          DemandaNoAtendida as integer,",
				"          Metodo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          FechaServicio,",
				"          RutaHistoricaId,",
				"          ParadaHistoricaId,",
				"          Franja,",
				"          Descensos,",
				"          DemandaNoAtendida,",
				"          Metodo",
				"     )) ~> sink1"
			]
		}
	}
}